# ForteL2 verifier — stock op-reth + op-node (chain 852 / Sepolia L1).
# Image for pserv `fortel2-replica-reth` only. Do not point a Web
# Service at this file (that would boot a second public verifier).
#
# Images pinned by immutable digest (ForteL2 Task 1 / D-0109). Tag strings
# are comments only — do not float off the digest. The runtime base is the
# pinned op-reth image itself (Wolfi, glibc 2.44). The entrypoint asserts
# the whole-line pin in scripts/op-reth-pin-check.py and fails closed
# otherwise. op-node must report `op-node version v1.19.8-9f76a9d2-…`
# (R-0021 / ForteL2 D-0147). The entrypoint asserts that version with no
# trailing digit, and commit 9f76a9d2, and fails closed otherwise.
#
# OP Labs op-node images are distroless (no /bin/sh). Do not RUN shell
# commands on that image — copy the binary into this runtime. op-geth is
# not in this image.
#
# Base image config, re-fetched 2026-10-07 (linux/amd64 config blob
# sha256:0c472a572b96a511a8c62dfdde13a10da0b484ea7bd7c9670524f763d2ff7b0c):
#   User: "0"
#   Entrypoint: ["/usr/local/bin/op-reth"]
#   Cmd: null
#   Env PATH and SSL_CERT_FILE
# Those are overridden explicitly below. USER fortel2 is uid/gid 10001
# because the live /data disk is owned by 10001.

FROM us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.8@sha256:adc6578b8b3c1cd065405c17bf593008ad21c3fc91cef6db72d370344432ba11 AS node
FROM us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.6.0@sha256:0bf70098c274127ecdf8bfb95851d646deb12622ab8319379b630434dcc61d6c AS reth

# Runtime. Same digest as `AS reth` (the only copy of the pin).
FROM reth

# The baked repositories file points at a melange build directory that does
# not exist here. Keep the public Wolfi repo only, or apk add fails closed.
# apk then drops the image's local op-reth package (it is not in that repo),
# so the binary is copied aside and put back. It only needs libc, libm,
# libstdc++, and libgcc_s, which stay.
# Package versions are pinned (`pkg=version`, R-0023). Transitive soname
# dependencies are whatever those exact packages require on the day of the build.
#   curl / libcurl-openssl4 — snapshot download
#   gnutar / gnutar-rmt — `tar --zstd` (busybox tar in this image has no --zstd)
#   openssl-4.0 — `openssl rand` (apk removes the base CLI while solving)
#   python-3.13-base / python3-as-3.13 — python3 for the pin check, genesis
#     hash, method filter, healthcheck, and L1 router
#   tzdata — zoneinfo America/Los_Angeles for the L1 router
#   zstd — `command -v zstd` and GNU tar's zstd program
# Already in the base, not reinstalled: ca-certificates, busybox 1.38.0-r2
# (sh, sed -E, grep -E, awk, sha256sum, mktemp, id, dirname).
USER root
RUN mkdir -p /opt/fortel2 \
  && cp -a /usr/local/bin/op-reth /opt/fortel2/op-reth \
  && printf '%s\n' 'https://packages.wolfi.dev/os' > /etc/apk/repositories \
  && apk add --no-cache \
    curl=8.22.0-r4 \
    libcurl-openssl4=8.22.0-r4 \
    gnutar=1.35-r12 \
    gnutar-rmt=1.35-r12 \
    openssl-4.0=4.0.3-r4 \
    python-3.13-base=3.13.16_git20261002-r2 \
    python3-as-3.13=0.1.0-r5 \
    tzdata=2026e-r0 \
    zstd=1.5.7-r10 \
  && cp -a /opt/fortel2/op-reth /usr/local/bin/op-reth \
  && chmod 755 /usr/local/bin/op-reth \
  && addgroup -g 10001 -S fortel2 \
  && adduser -u 10001 -G fortel2 -D -H -h /data -s /sbin/nologin -S fortel2 \
  && mkdir -p /config /data \
  && chown 10001:10001 /data

COPY --from=node /usr/local/bin/op-node /usr/local/bin/op-node
COPY entrypoint-reth.sh /entrypoint.sh
COPY healthcheck-reth.sh /healthcheck.sh
COPY scripts/op-reth-pin-check.py /op-reth-pin-check.py
COPY l1_rpc_router.py /l1_rpc_router.py
COPY rpc-method-filter.py /rpc-method-filter.py
COPY config/genesis.json /config/genesis.json
COPY config/rollup.json /config/rollup.json
RUN chmod +x /entrypoint.sh /healthcheck.sh /op-reth-pin-check.py /l1_rpc_router.py /rpc-method-filter.py \
    /usr/local/bin/op-reth /usr/local/bin/op-node

# Render Web Service sets PORT (often 10000) for the public method filter.
# op-reth HTTP stays on loopback L2_GETH_HTTP_PORT; op-node on loopback :9545.
# PATH keeps the base image's directories and puts our binaries first.
# SSL_CERT_FILE from the base image is left in place.
ENV DATA_DIR=/data \
    HOME=/data \
    L2_HTTP_PORT=8545 \
    L2_GETH_HTTP_PORT=8546 \
    L2_ENGINE_PORT=8551 \
    L2_NODE_RPC_PORT=9545 \
    L1_BLOCK_TIME=12 \
    TZ=America/Los_Angeles \
    GENESIS=/config/genesis.json \
    ROLLUP=/config/rollup.json \
    PATH="/usr/local/bin:${PATH}"

VOLUME ["/data"]
EXPOSE 8545

# Override the base image User/Entrypoint/Cmd. Cmd is empty so the base
# entrypoint's default args cannot be appended to /entrypoint.sh.
USER fortel2
# During --start-period, failed probes (no FORTEL2_EL_READY_FILE yet / no RPC)
# keep health=starting and do not count toward --retries. healthcheck.sh must
# exit 1 while starting — exit 0 would mark healthy immediately. Raise
# start-period if constrained disks regularly need longer than 5m recovery.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
  CMD ["/healthcheck.sh"]
ENTRYPOINT ["/entrypoint.sh"]
CMD []
