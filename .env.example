# Copy to .env for local docker compose (never commit .env).
# Compose reads only the "local compose" keys below.
# Render dashboard / single-container image: paste from README.md tables
# (Blueprint `value:` keys and `sync: false` secrets). Do not treat this
# file as the Render checklist.

# --- Local compose (required) ---
# Sepolia HTTPS. publicnode is fine for a laptop smoke test; it can return
# 0 receipts and stall derivation (D-0105). Use a dedicated provider for
# sustained sync. Not the Mac mini sequencer URL.
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Local compose (optional; compose interpolates these) ---
L1_BLOCK_TIME=12
L1_HTTP_POLL_INTERVAL=24s
L1_RPC_RATE_LIMIT=5
L1_RPC_KIND=quicknode
# Replaces GETH_CACHE_MB. Pinned op-reth default is 4096 MB (OOM on 2 GB).
RETH_CROSS_BLOCK_CACHE_MB=256
RETH_RPC_CACHE_MAX_BLOCKS=256
# op-node L1 receipt cache (upstream default 900; 0 expands to ~2400 — never set 0)
L1_CACHE_SIZE=128
L1_MAX_CONCURRENCY=2
L1_RPC_MAX_BATCH_SIZE=5

# --- Render only (ignored by docker-compose.yml) ---
# JWT_SECRET=   # do not set on fortel2-replica-reth — JWT is generated in-container
# OP_NODE_GOMEMLIMIT=768MiB
# L1_RPC_SCHEDULE=off
# L1_RPC_FORCE=metered
# TZ=America/Los_Angeles
# L1_RPC_BUSINESS_START=9
# L1_RPC_BUSINESS_END=17
# L1_RPC_PUBLIC_URL=https://ethereum-sepolia-rpc.publicnode.com
# L1_USE_PUBLIC_RPC=0
# RETH_READY_TIMEOUT_SECS=0
# Snapshot restore (R-0014) — dashboard on fortel2-replica-reth only:
# RETH_SNAPSHOT_URL=
# RETH_SNAPSHOT_SHA256=
# RETH_SNAPSHOT_FORCE=   # 1 once to replace existing db/static_files/rocksdb; unset after
