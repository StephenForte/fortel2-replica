# Copy to .env for local docker compose (never commit .env).
# Compose reads only the "local compose" keys below.
# Render dashboard / single-container image: paste from README.md tables
# (Blueprint `value:` keys and `sync: false` secrets). Do not treat this
# file as the Render checklist.

# --- Local compose (required) ---
# Sepolia HTTPS. publicnode is fine for a laptop smoke test; use a dedicated
# provider for sustained sync. Not the Mac mini sequencer URL.
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Local compose (optional; compose interpolates these) ---
L1_BLOCK_TIME=12
L1_HTTP_POLL_INTERVAL=24s
L1_RPC_RATE_LIMIT=5
# geth --cache (compose default is 256 if unset)
GETH_CACHE_MB=128

# --- Render only (ignored by docker-compose.yml) ---
# JWT_SECRET=
# GETH_GOMEMLIMIT=700MiB
# OP_NODE_GOMEMLIMIT=768MiB
# L1_RPC_SCHEDULE=business
# TZ=America/Los_Angeles
# L1_RPC_BUSINESS_START=9
# L1_RPC_BUSINESS_END=17
# L1_RPC_PUBLIC_URL=https://ethereum-sepolia-rpc.publicnode.com
# L1_USE_PUBLIC_RPC=0
# L1_RPC_FORCE=public
# L1_RPC_FORCE=metered
# GETH_READY_TIMEOUT_SECS=0
