# Copy to .env for local docker compose (never commit .env).
# On Render: Blueprint-managed services sync `value:` keys from render.yaml;
# `sync: false` secrets below are dashboard-only after first create.
# Dashboard-created (unattached) services: paste from README.md tables.

# --- Required secret (Render; sync: false in Blueprint) ---
# Render-only QuickNode Sepolia HTTPS (not the Mac mini URL).
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Optional secret (Render; sync: false in Blueprint) ---
# 64 hex chars; omit to auto-generate jwt.txt on the /data volume.
# JWT_SECRET=

# --- Chain / L1 (Render + local) ---
L1_BLOCK_TIME=12

# --- Memory (Render Standard 2GB; Blueprint `value:` keys) ---
GETH_CACHE_MB=128
GETH_GOMEMLIMIT=700MiB
OP_NODE_GOMEMLIMIT=768MiB

# --- L1 RPC schedule (Render single-container image only) ---
# QuickNode 09:00–17:00 America/Los_Angeles, publicnode overnight.
L1_RPC_SCHEDULE=business
TZ=America/Los_Angeles
L1_RPC_BUSINESS_START=9
L1_RPC_BUSINESS_END=17
L1_RPC_PUBLIC_URL=https://ethereum-sepolia-rpc.publicnode.com
L1_USE_PUBLIC_RPC=0

# --- L1 credit throttle (op-node) ---
L1_HTTP_POLL_INTERVAL=24s
L1_RPC_RATE_LIMIT=5

# --- Overrides (optional) ---
# L1_RPC_FORCE=public
# L1_RPC_FORCE=metered
# L1_USE_PUBLIC_RPC=1
# GETH_READY_TIMEOUT_SECS=0
