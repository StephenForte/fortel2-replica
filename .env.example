# Copy to .env for local docker compose (never commit .env).
# On Render, set these as environment secrets / env vars.

# Ethereum Sepolia HTTPS — Render-only QuickNode endpoint (not the Mac mini URL).
# Required for L1_RPC_SCHEDULE=business (daytime metered upstream).
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Time-of-day router (Render single-container image): QuickNode 09:00–17:00 local TZ,
# publicnode overnight. Cutover is automatic inside the container — no redeploy.
# L1_RPC_SCHEDULE=business
# TZ=America/Los_Angeles
# L1_RPC_BUSINESS_START=9
# L1_RPC_BUSINESS_END=17
# L1_RPC_PUBLIC_URL=https://ethereum-sepolia-rpc.publicnode.com
#
# Manual overrides (skip schedule until you clear them):
#   L1_RPC_FORCE=public | metered
#   L1_USE_PUBLIC_RPC=1          # same as FORCE=public
# L1_USE_PUBLIC_RPC=0

# Must match sequencer slot override (Sepolia ~12s; calldata DA / beacon ignored)
L1_BLOCK_TIME=12

# Credit-budget L1 RPC knobs (op-node). Defaults favor low burn on Render.
# L1_HTTP_POLL_INTERVAL=24s
# L1_RPC_RATE_LIMIT=5

# Optional: pin JWT across restarts (64 hex chars). Empty → generated on disk volume.
# JWT_SECRET=

# Optional: 0 = wait forever while geth pid alive (Render archive recovery)
# GETH_READY_TIMEOUT_SECS=0
# geth --cache MB (default 256). Raise on ≥2GB hosts; Starter 512MB RAM cannot run this stack.
# GETH_CACHE_MB=256
