#!/bin/sh
# vim:sw=2:ts=2:sts=2:et
#
# Sourced by the nginx image entrypoint *before* 20-envsubst-on-templates.sh
# (.envsh, not .sh — a subprocess would lose the export).
#
# nginx only re-resolves a proxy_pass hostname when the address is a
# variable *and* a resolver directive is set. The resolver must be the
# same nameserver this container already uses (Render private DNS lives
# there). A public resolver does not know fortel2-replica and would
# 502 every request.
#
# nginx's resolver does *not* apply /etc/resolv.conf `search` domains
# (G-2 / PR #32 outage: Host not found on the bare short name). A
# literal proxy_pass uses getaddrinfo, which does. So a bare host in
# REPLICA_UPSTREAM is qualified with the first search domain here,
# before envsubst writes the config. A host that already contains a
# dot (FQDN, operator override, IPv4) is left alone.
#
# Same awk as nginxinc's 15-local-resolvers.envsh (IPv6 bracketed), but
# always-on and fail-loud: an empty nameserver list must not start nginx
# with `resolver ;`. A missing search line is not an error — the bare
# name is used as-is.
#
# Override RESOLV_CONF only in tests. Not an operator contract key.
# NGINX_LOCAL_RESOLVERS / NGINX_SEARCH_DOMAIN / NGINX_REPLICA_UPSTREAM
# are derived at start; do not set them in the Dashboard.

set -eu

LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RESOLV_CONF="${RESOLV_CONF:-/etc/resolv.conf}"

NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' "$RESOLV_CONF")
NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"

if [ -z "$NGINX_LOCAL_RESOLVERS" ]; then
  echo "$0: ERROR: no nameserver in ${RESOLV_CONF}; cannot configure nginx resolver" >&2
  exit 1
fi

# First token of the first `search` line. `domain` is ignored — it is
# not what Render emits, and guessing a fallback is how G-2 failed.
NGINX_SEARCH_DOMAIN=$(awk '$1=="search" && NF>=2 {print $2; exit}' "$RESOLV_CONF")
NGINX_SEARCH_DOMAIN="${NGINX_SEARCH_DOMAIN:-}"

if [ -z "${REPLICA_UPSTREAM:-}" ]; then
  echo "$0: ERROR: REPLICA_UPSTREAM is empty; cannot qualify upstream host" >&2
  exit 1
fi

# Qualify the host portion only. scheme://host:port (optional /path).
NGINX_REPLICA_UPSTREAM="$REPLICA_UPSTREAM"
case "$REPLICA_UPSTREAM" in
  *://*)
    _scheme="${REPLICA_UPSTREAM%%://*}"
    _rest="${REPLICA_UPSTREAM#*://}"
    case "$_rest" in
      \[*)
        # IPv6 literal — already dotted-or-colon, never a short name.
        ;;
      *)
        _host="${_rest%%[:/]*}"
        _suffix="${_rest#"$_host"}"
        case "$_host" in
          *.*|"")
            ;;
          *)
            if [ -n "$NGINX_SEARCH_DOMAIN" ]; then
              NGINX_REPLICA_UPSTREAM="${_scheme}://${_host}.${NGINX_SEARCH_DOMAIN}${_suffix}"
            fi
            ;;
        esac
        ;;
    esac
    ;;
esac

export NGINX_LOCAL_RESOLVERS
export NGINX_SEARCH_DOMAIN
export NGINX_REPLICA_UPSTREAM

echo "$0: resolver=${NGINX_LOCAL_RESOLVERS} search=${NGINX_SEARCH_DOMAIN:-<none>} upstream=${NGINX_REPLICA_UPSTREAM}" >&2
