#!/bin/sh
# vim:sw=2:ts=2:sts=2:et
#
# Sourced by the nginx image entrypoint *before* 20-envsubst-on-templates.sh
# (.envsh, not .sh — a subprocess would lose the export).
#
# nginx only re-resolves a proxy_pass hostname when the address is a
# variable *and* a resolver directive is set. The resolver must be the
# same nameserver this container already uses (Render private DNS lives
# there). A public resolver does not know fortel2-replica and would
# 502 every request.
#
# Same awk as nginxinc's 15-local-resolvers.envsh (IPv6 bracketed), but
# always-on and fail-loud: an empty nameserver list must not start nginx
# with `resolver ;`.
#
# Override RESOLV_CONF only in tests. Not an operator contract key.

set -eu

LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RESOLV_CONF="${RESOLV_CONF:-/etc/resolv.conf}"

NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' "$RESOLV_CONF")
NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"

if [ -z "$NGINX_LOCAL_RESOLVERS" ]; then
  echo "$0: ERROR: no nameserver in ${RESOLV_CONF}; cannot configure nginx resolver" >&2
  exit 1
fi

export NGINX_LOCAL_RESOLVERS
