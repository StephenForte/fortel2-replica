# ForteL2 public RPC gateway — included in http {} via conf.d/.
# Braced env names are substituted at container start. nginx
# variables ($remote_addr and friends) are left alone — see
# NGINX_ENVSUBST_FILTER.

# Re-resolve the replica hostname on each request (respecting DNS TTL).
# A literal proxy_pass is resolved once at config load and cached for
# the process lifetime — after a replica redeploy that is a dead IP
# and every request 504s until this container is restarted.
# nginx only re-queries DNS when proxy_pass uses a variable *and* a
# resolver is set. NGINX_LOCAL_RESOLVERS is filled from this
# container's /etc/resolv.conf at start (14-resolvers-from-resolv.conf.envsh).
# Do not hardcode 8.8.8.8 / 1.1.1.1 — Render private names do not exist there.
resolver ${NGINX_LOCAL_RESOLVERS};
resolver_timeout 5s;

# Real-IP / rate-limit key
# ------------------------
# This container never sees the client TCP peer. Every Render Web Service
# terminates TLS at Cloudflare, then a Render proxy (typically 10/8).
# Keying limit_req on $binary_remote_addr *without* rewriting it puts
# every client on earth in one bucket — a self-DoS that looks healthy
# under single-client testing.
#
# ngx_http_realip_module:
#   real_ip_header     ${RPC_REAL_IP_HEADER}   (default CF-Connecting-IP)
#   real_ip_recursive  on
#   set_real_ip_from   RFC1918 / loopback / link-local / CGNAT / Cloudflare
#
# Default header is CF-Connecting-IP: a single, CF-authored client IP.
# Render's platform edge always sets it. Operator orange-cloud (optional
# second CF hop) overwrites it with the same client. Do not treat
# Cloudflare as optional on this deploy path.
#
# If RPC_REAL_IP_HEADER=X-Forwarded-For: we take the RIGHTMOST untrusted
# address. nginx walks from the right, skips set_real_ip_from hops, and
# stops at the first address that is not trusted. Cloudflare CIDRs must
# be trusted — otherwise the walk stops on the CF PoP (104.x / 172.64/13
# / 162.158/15) and every visitor at that PoP shares one 20 r/s bucket.
# Leftmost is ignored: Render appends to XFF and does not reset it, so a
# client can send `X-Forwarded-For: 1.2.3.4` and leftmost is attacker-
# controlled.
#
# Header absent or unparseable: real_ip leaves $remote_addr as the TCP
# peer. An empty limit_req_zone key disables the limiter silently; the
# map below never emits one (empty → 0.0.0.0, a shared fail-closed bucket).

map $remote_addr $rpc_limit_key {
    ""      0.0.0.0;
    default $remote_addr;
}

limit_req_zone $rpc_limit_key zone=rpc:10m rate=${RPC_RATE};
limit_req_status 429;

log_format rpc_gateway escape=default
    '$remote_addr key=$rpc_limit_key peer=$realip_remote_addr '
    '$request_method $request_uri $status '
    'xff="$http_x_forwarded_for" cf="$http_cf_connecting_ip"';

# Trust only hops that can sit between the client and this container.
# Do not add 0.0.0.0/0 — that would make the leftmost (spoofable) XFF
# entry win. If the peer is not in this list, real_ip does not rewrite
# and every client shares the peer bucket (loud, not silent).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.0/8;
set_real_ip_from 169.254.0.0/16;
set_real_ip_from 100.64.0.0/10;
set_real_ip_from ::1;
set_real_ip_from fc00::/7;
set_real_ip_from fe80::/10;

# Cloudflare published ranges (https://www.cloudflare.com/ips/ as of
# 2026-08-16). Render's edge is always CF; 172.64.0.0/13 is CF, not
# RFC1918 (172.16.0.0/12 ends at 172.31.255.255). Without these, an
# X-Forwarded-For walk keys on the PoP. Refresh if CF republishes.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

real_ip_header ${RPC_REAL_IP_HEADER};
real_ip_recursive on;

server {
    listen ${PORT};
    server_name _;

    client_max_body_size ${RPC_MAX_BODY};

    access_log /dev/stdout rpc_gateway;
    error_log  /dev/stderr warn;

    # Local liveness. No proxy_pass, no limit_req — Render / compose
    # probes must not consume the per-IP budget or depend on the replica.
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # Everything else, including GET /, goes to the replica method filter.
    # CORS is owned by the filter — do not add, hide, or rewrite it here.
    location / {
        limit_req zone=rpc burst=${RPC_BURST} nodelay;

        # Variable form is what makes the resolver above run per request.
        # $request_uri is required when proxy_pass is a variable: nginx
        # will not infer the original path/query the way a no-path
        # literal proxy_pass does. Upstream is scheme://host:port only.
        set $replica_upstream ${REPLICA_UPSTREAM};
        proxy_pass $replica_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
